<Window x:Class="ExamTickets.Wpf.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результат"
        AutomationProperties.AutomationId="ResultWindow"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>
    <StackPanel Margin="16">
        <TextBlock AutomationProperties.AutomationId="TicketTitle"
                   Text="{Binding Title}"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock AutomationProperties.AutomationId="StudentName"
                   Text="{Binding StudentName}"
                   Margin="0,4,0,12"
                   Foreground="Gray" />
        <ItemsControl AutomationProperties.AutomationId="QuestionsList" ItemsSource="{Binding Questions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Нажмите Esc, чтобы вернуться к выбору."
                   Margin="0,12,0,0"
                   Foreground="Gray"
                   FontSize="11" />
    </StackPanel>
</Window>
